# 이 파일을 .env로 복사해서 값을 채우세요. .env는 Git에 올리지 않습니다.

# OpenAI 호환 API (교육장 가상 키)
# 키는 이 .env에만 적고 코드·Git·README·스크린샷에는 절대 넣지 않습니다
OPENAI_API_KEY=<교육장에서 발급받은 virtual-key>
OPENAI_BASE_URL=https://copa.codyssey.kr/v1
OPENAI_MODEL=gpt-5-mini

# Firebase 서비스 계정 키: 둘 중 하나
# 1) 로컬 개발: 키 파일 경로
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# 2) Render 배포: 키 JSON 전체를 문자열 그대로, 또는 base64로 인코딩해서
# FIREBASE_CREDENTIALS=

# 데이터를 바꾸는 요청(POST/PUT/DELETE, 채팅)에 필요한 키. 비워 두면 키 확인을 하지 않음(로컬 전용)
APP_API_KEY=change-me

# CORS 허용 도메인 (쉼표로 구분). 배포 후 Vercel 주소로 바꾸세요
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# firestore | memory (memory는 Firebase 없이 화면을 먼저 확인할 때)
STORAGE=firestore

# 시세 종목과 처음 받을 시작일
TICKERS=TQQQ,SOXL
PRICE_START=2024-01-01

# GPT Actions 스키마에 들어갈 공개 주소 (Render URL)
PUBLIC_API_URL=http://127.0.0.1:8000
